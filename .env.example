# ==============================================================================
# Voice AI Patient Registration System — Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="Voice AI Patient Registration System"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Database Configuration (Async SQLite default, PostgreSQL ready)
DATABASE_URL="sqlite+aiosqlite:///./patients.db"

# Security & Webhook Authentication
# Used to authenticate incoming tool calls from Vapi/telephony
WEBHOOK_SECRET="vapi_secret_token_change_me_in_production"
API_KEY="test_api_key_for_rest_endpoints"

# Vapi Telephony & Voice Configuration
VAPI_API_KEY=""
VAPI_PHONE_NUMBER=""
VAPI_ASSISTANT_ID=""

# OpenAI-Compatible LLM Provider (Groq, OpenRouter, DeepSeek, Together, Ollama, Gemini)
# Free option 1: Groq (Ultra-fast, free tier) -> https://console.groq.com
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="gsk_your_groq_api_key_here"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.1

# Free option 2: OpenRouter (has 100% free models like meta-llama/llama-3.3-70b-instruct:free)
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_API_KEY="sk-or-your-openrouter-key"
# LLM_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Free option 3: Local Ollama
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_API_KEY="ollama"
# LLM_MODEL="llama3.2"
