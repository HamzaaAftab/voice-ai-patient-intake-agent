[
  {
    "type": "function",
    "function": {
      "name": "register_patient",
      "description": "Persist a new patient demographic record to the clinical database after the caller confirms all details during read-back.",
      "parameters": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "description": "Patient legal first name (alphabetic, hyphens, apostrophes)."
          },
          "last_name": {
            "type": "string",
            "description": "Patient legal last name (alphabetic, hyphens, apostrophes)."
          },
          "date_of_birth": {
            "type": "string",
            "description": "Date of birth in YYYY-MM-DD or MM/DD/YYYY format. Must not be in the future."
          },
          "sex": {
            "type": "string",
            "enum": ["Male", "Female", "Other", "Decline to Answer"],
            "description": "Patient biological sex or preferred intake response."
          },
          "phone_number": {
            "type": "string",
            "description": "Valid 10-digit U.S. telephone number (e.g. 4155552671)."
          },
          "address_line_1": {
            "type": "string",
            "description": "Primary street address."
          },
          "address_line_2": {
            "type": "string",
            "description": "Optional apartment, suite, or unit number."
          },
          "city": {
            "type": "string",
            "description": "City name."
          },
          "state": {
            "type": "string",
            "description": "Valid 2-letter U.S. state postal code (e.g. CA, TX, NY, PA)."
          },
          "zip_code": {
            "type": "string",
            "description": "Valid 5-digit U.S. ZIP code or ZIP+4."
          },
          "email": {
            "type": "string",
            "description": "Optional contact email address."
          },
          "insurance_provider": {
            "type": "string",
            "description": "Optional healthcare insurance company name."
          },
          "insurance_member_id": {
            "type": "string",
            "description": "Optional insurance member ID or subscriber policy number."
          },
          "preferred_language": {
            "type": "string",
            "description": "Primary language spoken (Default: 'English', 'Spanish', etc.)."
          },
          "emergency_contact_name": {
            "type": "string",
            "description": "Optional emergency contact full name."
          },
          "emergency_contact_phone": {
            "type": "string",
            "description": "Optional emergency contact 10-digit phone number."
          }
        },
        "required": [
          "first_name",
          "last_name",
          "date_of_birth",
          "sex",
          "phone_number",
          "address_line_1",
          "city",
          "state",
          "zip_code"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "check_existing_patient",
      "description": "Look up if an incoming caller has an existing patient record in the database using their telephone number.",
      "parameters": {
        "type": "object",
        "properties": {
          "phone_number": {
            "type": "string",
            "description": "10-digit U.S. telephone number to look up."
          }
        },
        "required": ["phone_number"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_patient",
      "description": "Update specific demographic fields for an existing patient record.",
      "parameters": {
        "type": "object",
        "properties": {
          "patient_id": {
            "type": "string",
            "description": "UUID of the patient record to update."
          },
          "phone_number": {
            "type": "string",
            "description": "Updated 10-digit U.S. phone number."
          },
          "address_line_1": {
            "type": "string",
            "description": "Updated street address."
          },
          "city": {
            "type": "string",
            "description": "Updated city."
          },
          "state": {
            "type": "string",
            "description": "Updated 2-letter state code."
          },
          "zip_code": {
            "type": "string",
            "description": "Updated ZIP code."
          },
          "insurance_provider": {
            "type": "string",
            "description": "Updated insurance carrier name."
          },
          "insurance_member_id": {
            "type": "string",
            "description": "Updated insurance policy ID."
          }
        },
        "required": ["patient_id"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "schedule_appointment",
      "description": "Book a clinical appointment for a newly registered or existing patient.",
      "parameters": {
        "type": "object",
        "properties": {
          "patient_id": {
            "type": "string",
            "description": "UUID of the registered patient."
          },
          "appointment_time": {
            "type": "string",
            "description": "ISO 8601 formatted date and time for the visit (e.g. '2026-09-08T10:00:00Z')."
          },
          "provider_name": {
            "type": "string",
            "description": "Assigned doctor or clinic name (Default: 'Dr. Sarah Smith, MD')."
          },
          "reason": {
            "type": "string",
            "description": "Reason for clinical visit (Default: 'New Patient Intake & Wellness Consultation')."
          }
        },
        "required": ["patient_id", "appointment_time"]
      }
    }
  }
]
